{
  "name": "cv-label",
  "version": "1.0.0",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps && electron-rebuild -f -w better-sqlite3",
    "db:generate": "drizzle-kit generate",
    "db:generate:app": "drizzle-kit generate --config drizzle.app.config.ts",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "test": "vitest",
    "test:e2e": "pnpm run build && playwright test",
    "build:mac": "pnpm run build && electron-builder --mac",
    "build:linux": "pnpm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@linaria/core": "^7.0.0",
    "@linaria/react": "^7.0.1",
    "@mantine/core": "^8.3.15",
    "@mantine/dropzone": "^8.3.15",
    "@mantine/hooks": "^8.3.15",
    "@mantine/modals": "^8.3.15",
    "@tanstack/react-query": "^5.96.1",
    "@wyw-in-js/babel-preset": "^1.0.6",
    "archiver": "^7.0.1",
    "better-sqlite3": "^12.6.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "i18next": "^26.0.6",
    "jszip": "^3.10.1",
    "mantine-contextmenu": "^8.3.13",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "react-virtuoso": "^4.18.11",
    "sharp": "^0.35.0",
    "tinycolor2": "^1.6.0",
    "uuid": "^13.0.2",
    "yaml": "^2.9.0",
    "yauzl": "^3.4.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "^1.61.1",
    "@tanstack/eslint-plugin-query": "^5.96.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/archiver": "^6.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/glob": "^8.1.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/tinycolor2": "^1.4.6",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@wyw-in-js/vite": "^1.0.6",
    "drizzle-kit": "^0.31.10",
    "electron": "^39.8.10",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "glob": "^13.0.3",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "postcss": "^8.5.16",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.8.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.5"
  },
  "build": {
    "asar": true,
    "files": [
      "out/**",
      "resources/**"
    ],
    "extraResources": [
      {
        "from": "drizzle",
        "to": "drizzle"
      },
      {
        "from": "drizzle-app",
        "to": "drizzle-app"
      }
    ]
  }
}
